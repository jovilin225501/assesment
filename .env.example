# Root environment variable template for Movie Watchlist Manager
# Copy to backend/.env and frontend/.env respectively for local execution

# Backend Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/movie_watchlist?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
